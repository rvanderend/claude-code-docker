# Kopieer naar .env en pas aan

# Map met je projecten op de host; wordt /workspace in de container
PROJECTS_DIR=/home/gebruiker/projects

# Blijvende home-map voor de container (login, instellingen, gesprekken van Claude Code)
CLAUDE_HOME=/home/gebruiker/claude-home

# Gebruiker/groep waaronder de container draait (id -u / id -g op de host)
PUID=1000
PGID=1000

TZ=Europe/Amsterdam

# Alleen nodig als je de Docker-socket mount: getent group docker | cut -d: -f3
# DOCKER_GID=999
