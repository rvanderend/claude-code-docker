# Kopieer naar .env en pas aan

# Map met je projecten op de host; wordt /workspace in beide containers
PROJECTS_DIR=/home/gebruiker/projects

# Blijvende home-map voor claude-code (login, instellingen, gesprekken van Claude Code)
CLAUDE_HOME=/home/gebruiker/claude-home

# Gebruiker/groep waaronder de containers draaien (id -u / id -g op de host)
PUID=1000
PGID=1000

# Groep-ID van 'docker' op de host: getent group docker | cut -d: -f3
DOCKER_GID=999

TZ=Europe/Amsterdam

# Browserterminal (claude-web)
WEB_USER=claude
WEB_PASSWORD=verander-mij
# 127.0.0.1 = alleen vanaf de server zelf (of via een reverse proxy / SSH-tunnel).
# 0.0.0.0   = vanaf je hele netwerk. Nooit rechtstreeks openzetten naar internet.
WEB_BIND=127.0.0.1
WEB_PORT=7681
